# License server configuration.
#
# Copy to `server/.env` and replace every CHANGE_ME value. `.env` is
# gitignored; only this template is committed. Never commit real secrets.
#
#   cp .env.example .env
#   python -c "import secrets; print(secrets.token_urlsafe(48))"   # generate one
#
# The server refuses to start (exit code 2) if LICENSE_JWT_SECRET,
# LICENSE_KEY_PEPPER or HWID_PEPPER is missing or too short.

# ---------------------------------------------------------------------------
# Database
# ---------------------------------------------------------------------------
# SQLAlchemy URL. SQLite by default; the schema is created by Alembic, not by
# the app, so run `python -m app.cli migrate` (or `init-db`) first.
#   SQLite      sqlite:///./license.db
#   PostgreSQL  postgresql+psycopg://user:password@localhost:5432/licenses
# Alembic reads this same variable, so no credentials are stored in alembic.ini.
DATABASE_URL=sqlite:///./license.db

# ---------------------------------------------------------------------------
# HTTP server
# ---------------------------------------------------------------------------
# Bind address. Use 0.0.0.0 only behind a reverse proxy that terminates TLS.
SERVER_HOST=127.0.0.1
SERVER_PORT=8080

# ---------------------------------------------------------------------------
# JWT signing (HS256)
# ---------------------------------------------------------------------------
# REQUIRED. At least 32 characters. Rotating this invalidates every issued
# token, including live admin sessions. Generate: secrets.token_urlsafe(48)
LICENSE_JWT_SECRET=CHANGE_ME_at_least_32_characters_long_random_value

# Only HS256 is permitted; the algorithm is pinned during verification so a
# token cannot downgrade itself to `none` or to an asymmetric algorithm.
JWT_ALGORITHM=HS256
# Verified `iss` / `aud` claims. Change the audience if you ship a second
# client that should not accept this server's tokens.
JWT_ISSUER=roblox-license-server
JWT_AUDIENCE=roblox-license-client

# Client session lifetime (15 minutes) and admin session lifetime (30 minutes).
# Clients are expected to re-authenticate when their session expires.
SESSION_TTL_SECONDS=900
ADMIN_SESSION_TTL_SECONDS=1800

# ---------------------------------------------------------------------------
# Server-only peppers
# ---------------------------------------------------------------------------
# REQUIRED, at least 16 characters each, and never the same as each other.
# These never leave the server and are not sent to any client.
#
# LICENSE_KEY_PEPPER keys the HMAC-SHA256 of a license key. Only that digest is
# stored, so a database leak yields no usable keys. Rotating it orphans every
# existing license row and requires a rehash migration.
LICENSE_KEY_PEPPER=CHANGE_ME_at_least_16_characters_random

# HWID_PEPPER keys a second server-side HMAC over the HWID the client already
# derived. Storing the client's own value would make a stolen row replayable
# against the client, so the server never persists what it receives. Rotating
# it unbinds every activated machine and forces re-activation.
HWID_PEPPER=CHANGE_ME_at_least_16_characters_random

# ---------------------------------------------------------------------------
# One-shot admin bootstrap
# ---------------------------------------------------------------------------
# OPTIONAL and only consulted by `python -m app.cli init-db` when the admins
# table is empty. Never logged, never returned by any endpoint. Leave unset in
# production; create admins with `python -m app.cli admin-create`.
ADMIN_USERNAME=
ADMIN_PASSWORD=

# ---------------------------------------------------------------------------
# Rate limiting (per client IP, fixed one-minute window)
# ---------------------------------------------------------------------------
RATE_LIMIT_ENABLED=true
# Activate and validate calls, which are the expensive HMAC path.
RATE_LIMIT_AUTH_PER_MINUTE=10
# Admin login, to blunt password guessing.
RATE_LIMIT_ADMIN_LOGIN_PER_MINUTE=5
# Authenticated admin API traffic.
RATE_LIMIT_ADMIN_API_PER_MINUTE=120
# Key generation.
RATE_LIMIT_KEYGEN_PER_MINUTE=30

# ---------------------------------------------------------------------------
# CORS
# ---------------------------------------------------------------------------
# Comma-separated origins, or a JSON array. Empty disables cross-origin access.
# The native client is not a browser and ignores CORS entirely.
CORS_ALLOWED_ORIGINS=

# ---------------------------------------------------------------------------
# Operations
# ---------------------------------------------------------------------------
# Reject client traffic with SERVICE_MAINTENANCE while leaving admin access up.
MAINTENANCE_MODE=false
# CRITICAL, ERROR, WARNING, INFO, DEBUG, NOTSET.
LOG_LEVEL=INFO
# Requests with a larger body are refused before parsing, so a malformed
# payload cannot be used to exhaust memory.
MAX_REQUEST_BODY_BYTES=16384

# ---------------------------------------------------------------------------
# Argon2id parameters for admin passwords
# ---------------------------------------------------------------------------
# Named BCRYPT_* for parity with the C++ side, but these are argon2id costs:
# time_cost (t), memory_cost in KiB (m), lanes (p). Raising these makes
# existing hashes report as needing a rehash on next successful login.
BCRYPT_TIME_COST=3
BCRYPT_MEMORY_COST=65536
BCRYPT_PARALLELISM=4

# ---------------------------------------------------------------------------
# KeyAuth integration (optional)
# ---------------------------------------------------------------------------
# If non-empty, the license server will forward license validation to KeyAuth
# in addition to the local database. All three values must be set for the
# integration to activate. Loaded from the project-root .env file.
KEYAUTH_OWNER_ID=
KEYAUTH_APP_SECRET=
KEYAUTH_APP_NAME=
