# Repository-level environment template.
#
# The license server is the only component here that needs environment
# variables. Its full, documented configuration lives in:
#
#     server/.env.example
#
# Create the real file from the server template and fill in the secrets:
#
#     cp server/.env.example server/.env
#
# `server/.env` is gitignored. Do not put real credentials in this file.

# --- License server (see server/.env.example for every option) ---
# DATABASE_URL=sqlite:///./license.db
# LICENSE_JWT_SECRET=
# LICENSE_KEY_PEPPER=
# HWID_PEPPER=

# --- C++ client (usermode.exe) ---
# Built by um/um.vcxproj; the license client is compiled in with
# /DLICENSE_CLIENT_ENABLE. Keep the server URL and shared secret out of
# source control.
# LICENSE_SERVER_URL=https://127.0.0.1:8080
